{%- set TYPES = {'boolean': 'boolean', 'string': 'string', 'timestamp': 'string',
                 'float32': 'number', 'float64': 'number', 'int8': 'number', 'uint8': 'number',
                 'int16': 'number', 'uint16': 'number', 'int32': 'number', 'uint32': 'number'} -%}

{%- macro ts(s) -%}
{%- if s.ref is defined -%}{{ s.ref }}
{%- elif s.elements is defined -%}{{ arr(s.elements) }}
{%- elif s.values is defined -%}Record<string, {{ ts(s.values) }}>
{%- elif s.enum is defined -%}{% for e in s.enum %}'{{ e }}'{{ ' | ' if not loop.last }}{% endfor %}
{%- elif s.type is defined -%}{{ TYPES[s.type] | default('unknown') }}
{%- elif s.properties is defined or s.optionalProperties is defined -%}{ {% for k, v in s.properties | default({}) | items %}{{ k }}: {{ ts(v) }}; {% endfor %}{% for k, v in s.optionalProperties | default({}) | items %}{{ k }}?: {{ ts(v) }}; {% endfor %}}
{%- else -%}unknown
{%- endif -%}
{{- ' | null' if s.nullable -}}
{%- endmacro -%}

{%- macro arr(e) -%}
{%- if e.nullable -%}({{ ts(e) }})[]{%- else -%}{{ ts(e) }}[]{%- endif -%}
{%- endmacro -%}
